{
  "name": "easy-markdown-editor-for-developers",
  "displayName": "Easy Markdown Editor for Developers",
  "description": "Edit Markdown visually inside VS Code.",
  "version": "0.0.1",
  "publisher": "yunsly",
  "repository": {
    "type": "git",
    "url": "https://github.com/yunsly/VSCode-MDeditor-extension.git"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "visualMarkdown.editor",
        "displayName": "Easy Markdown Editor for Developers",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "main": "./dist/extension.js",
  "scripts": {
    "typecheck:extension": "tsc --noEmit -p tsconfig.json",
    "typecheck:webview": "tsc --noEmit -p webview/tsconfig.json",
    "typecheck": "npm run typecheck:extension && npm run typecheck:webview",
    "lint": "eslint \"src/**/*.ts\" \"webview/src/**/*.ts\"",
    "test": "vitest run",
    "build:extension": "node esbuild.mjs",
    "build:webview": "vite build --config webview/vite.config.ts",
    "build": "npm run typecheck && npm run build:extension && npm run build:webview",
    "vscode:prepublish": "npm run build",
    "package:vsix": "vsce package",
    "watch:extension": "node esbuild.mjs --watch",
    "watch:webview": "node webview/watch.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/vscode": "1.125.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@milkdown/crepe": "7.21.3",
    "@milkdown/kit": "7.21.3"
  }
}
